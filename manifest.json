{
  "manifest_version": 3,
  "name": "YouTube Range Looper",
  "version": "1.0.0",
  "description": "Repeat just the part you need. Set start and stop times for the current YouTube video.",
  "minimum_chrome_version": "100",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Loop a YouTube range",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js",
        "src/panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
